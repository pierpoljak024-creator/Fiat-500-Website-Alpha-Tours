# Copy to .env.local and fill in. NEXT_PUBLIC_* values are public.
# WhatsApp is the only contact channel — leave NEXT_PUBLIC_PHONE blank so no
# phone number is displayed anywhere (see lib/site.ts: hasPhone hides the rows).
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=alphatourssrl@gmail.com
NEXT_PUBLIC_WHATSAPP=393758297864
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_SITE_URL=https://alphatoursrome.com

RESEND_API_KEY=
INQUIRY_TO_EMAIL=
# Must be an address on a domain verified in Resend (alphatoursrome.com).
INQUIRY_FROM=Alpha Tours Rome <hello@alphatoursrome.com>
INQUIRY_WEBHOOK_URL=
